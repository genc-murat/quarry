{
  "name": "quarry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Quarry — a modular, themeable database studio built with Tauri, starting with MySQL 5.6.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/tsx-loader.mjs --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "check:drift": "cargo test --manifest-path src-tauri/Cargo.toml descriptor_snapshot && node --test src/lib/fixtureDrift.test.ts",
    "preview": "vite preview",
    "preview:html": "npm run build && node scripts/build-preview.mjs",
    "icon": "node scripts/generate-icon.mjs src-tauri/app-icon.png && tauri icon src-tauri/app-icon.png --output src-tauri/icons",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.43.13",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.9.0",
    "@uiw/react-codemirror": "^4.23.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.28.2",
    "@rollup/rollup-darwin-arm64": "^4.64.0",
    "@tauri-apps/cli-darwin-arm64": "^2.12.1"
  }
}
